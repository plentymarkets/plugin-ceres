{% import "Ceres::Widgets.Helper.TwigBuilder" as Twig %}
{% import "Ceres::Widgets.Helper.WidgetHelper" as WidgetHelper %}

{% set customClass = widget.settings.customClass.mobile %}
{% set appearance = widget.settings.appearance.mobile %}
{% set renderInline = widget.settings.renderInline.mobile %}

{% set spacingSettings = widget.settings.spacing %}
{% set inlineSpacings = WidgetHelper.getInlineSpacings(spacingSettings, spacingSettings.customPadding.mobile, spacingSettings.customMargin.mobile) %}
{% set spacingClasses = WidgetHelper.getSpacingClasses(spacingSettings, spacingSettings.customPadding.mobile, spacingSettings.customMargin.mobile) %}

{% if not renderInline %}
    {{ Twig.component("Ceres::Checkout.Components.GuaranteeNotice") }}
{% endif %}

<div class="widget widget-guarantee-notice widget-{{ appearance | default("primary") }}{% if customClass | length > 0 %} {{ customClass }}{% endif %}{% if spacingClasses | length > 0 %} {{ spacingClasses }}{% endif %}"
    {% if inlineSpacings | length > 0 %} style="{{ inlineSpacings }}"{% endif %}>
    {% if renderInline %}
        <div class="text-center mt-2">
            <lazy-img
                image-url="{{ plugin_path('Ceres') }}/images/guarantee_notice/{{ guarantee_notice_svg_filename(lang) }}"
                alt="{{ trans("Ceres::Template.checkoutGuaranteeNoticeLink") }}">
            </lazy-img>
        </div>
    {% else %}
        <guarantee-notice></guarantee-notice>
    {% endif %}
</div>
