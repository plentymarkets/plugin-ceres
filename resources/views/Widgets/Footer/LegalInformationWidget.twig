{% import "Ceres::Widgets.Helper.TwigBuilder" as Twig %}
{% import "Ceres::Widgets.Helper.WidgetHelper" as WidgetHelper %}

{% set customClass = widget.settings.customClass.mobile %}
{% set spacingSettings = widget.settings.spacing %}
{% set inlineSpacings = WidgetHelper.getInlineSpacings(spacingSettings, spacingSettings.customPadding.mobile, spacingSettings.customMargin.mobile) %}
{% set spacingClasses = WidgetHelper.getSpacingClasses(spacingSettings, spacingSettings.customPadding.mobile, spacingSettings.customMargin.mobile) %}

{% set configuration = {
    showLegalDisclosure: widget.settings.showLegalDisclosure.mobile,
    showPrivacyPolicy: widget.settings.showPrivacyPolicy.mobile,
    showGtc: widget.settings.showGtc.mobile,
    showDeclarationOfAccessibility: widget.settings.showDeclarationOfAccessibility.mobile,
    showCancellationRights: widget.settings.showCancellationRights.mobile,
    showCancellationForm: widget.settings.cancellationFormContainer.showCancellationForm.mobile,
    styleLinkAsButton: widget.settings.cancellationFormContainer.styleLinkAsButton.mobile,
    useCancellationPdfUpload: widget.settings.cancellationFormContainer.useCancellationPdfUpload.mobile,
    cancellationPdfPath: widget.settings.cancellationFormContainer.cancellationPdfPath.mobile
} %}

<div class="widget-legal-information text-center my-3{% if customClass | length > 0 %} {{ customClass }}{% endif %}{% if spacingClasses | length > 0 %} {{ spacingClasses }}{% endif %}"
    {% if inlineSpacings | length > 0 %} style="{{ inlineSpacings }}"{% endif %}>
    <div>
        {{ Twig.do('autoescape false') }}

        {% if configuration.showLegalDisclosure %}
            <a class="py-4 px-2" href="{{ Twig.print('urls.legalDisclosure') }}">{{ Twig.trans("Ceres::Template.footerLegalDisclosure", {"hyphen": "&shy;"}) }}</a>
        {% endif %}

        {% if configuration.showPrivacyPolicy %}
            <a class="py-4 px-2" href="{{ Twig.print('urls.privacyPolicy') }}">{{ Twig.trans("Ceres::Template.footerPrivacyPolicy", {"hyphen": "&shy;"}) }}</a>
        {% endif %}

        {% if configuration.showGtc %}
            <a class="py-4 px-2" href="{{ Twig.print('urls.gtc') }}">{{ Twig.trans("Ceres::Template.footerGtc", {"hyphen": "&shy;"}) }}</a>
        {% endif %}

        {% if configuration.showDeclarationOfAccessibility %}
            <a class="py-4 px-2" href="{{ Twig.print('urls.declarationOfAccessibility') }}">{{ Twig.trans("Ceres::Template.footerDeclarationOfAccessibility", {"hyphen": "&shy;"}) }}</a>
        {% endif %}

        {% if configuration.showCancellationRights %}
            <a class="py-4 px-2" href="{{ Twig.print('urls.cancellationRights') }}">{{ Twig.trans("Ceres::Template.footerCancellationRight", {"hyphen": "&shy;"}) }}</a>
        {% endif %}

        {% if configuration.showCancellationForm %}
            {% if not configuration.useCancellationPdfUpload %}
                {% if configuration.styleLinkAsButton is not same as(false) %}
                    <a class="btn btn-primary py-2 px-4" href="{{ Twig.print('urls.cancellationForm') }}">{{ Twig.trans("Ceres::Template.footerWithdrawFromContract") }}</a>
                {% else %}
                    <a class="py-4 px-2" href="{{ Twig.print('urls.cancellationForm') }}">{{ Twig.trans("Ceres::Template.footerCancellationForm", {"hyphen": "&shy;"}) }}</a>
                {% endif %}
            {% elseif configuration.cancellationPdfPath is not empty %}
                {% if configuration.styleLinkAsButton is not same as(false) %}
                    <a class="btn btn-primary py-2 px-4" href="{{ configuration.cancellationPdfPath }}" target="_blank">{{ Twig.trans("Ceres::Template.footerWithdrawFromContract") }}</a>
                {% else %}
                    <a class="py-4 px-2" href="{{ configuration.cancellationPdfPath }}" target="_blank">{{ Twig.trans("Ceres::Template.footerCancellationForm", {"hyphen": "&shy;"}) }}</a>
                {% endif %}
            {% endif %}
        {% endif %}


        {{ Twig.if('(config("Ceres.contact.shop_mail") | length > 0 and config("Ceres.contact.shop_mail") != "your@email.com") or config("IO.routing.category_contact") > 0') }}
            <a class="py-4 px-2" href="{{ Twig.print('urls.contact') }}">{{ Twig.trans("Ceres::Template.footerContact") }}</a>
        {{ Twig.endif() }}
        {{ Twig.do('endautoescape') }}
    </div>
</div>